{
  "format": "custom",
  "id": "invoice",
  "label": "Invoice",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "invoice_number": {
        "type": "Text",
        "config": {
          "label": "Invoice Number",
          "placeholder": ""
        }
      },
      "client_name": {
        "type": "Text",
        "config": {
          "label": "Client Name",
          "placeholder": ""
        }
      },
      "project_title": {
        "type": "Text",
        "config": {
          "label": "Project Title",
          "placeholder": ""
        }
      },
      "issue_date": {
        "type": "Date",
        "config": {
          "label": "Issue Date",
          "placeholder": ""
        }
      },
      "due_date_label": {
        "type": "Text",
        "config": {
          "label": "Due Date Label",
          "placeholder": ""
        }
      },
      "status": {
        "type": "Select",
        "config": {
          "label": "Status",
          "placeholder": "",
          "options": ["Outstanding", "Paid"],
          "default_value": "Outstanding"
        }
      },
      "line_items": {
        "type": "Group",
        "config": {
          "label": "Line Items",
          "repeat": true,
          "fields": {
            "description": {
              "type": "Text",
              "config": {
                "label": "Description",
                "placeholder": ""
              }
            },
            "hours": {
              "type": "Number",
              "config": {
                "label": "Hours",
                "placeholder": ""
              }
            },
            "rate": {
              "type": "Number",
              "config": {
                "label": "Rate",
                "placeholder": ""
              }
            }
          }
        }
      }
    }
  }
}
